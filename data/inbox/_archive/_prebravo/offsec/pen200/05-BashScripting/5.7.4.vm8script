[?2004l#!/bin/bash

threeocts=$1
start=$2
end=$3


for ip in $(seq $start $end); 
do 
    ip="$threeocts.$ip"
    if ping -c 1 $ip &> /dev/null
    then
        echo $ip
    #   else
    #   echo "error"
    fi

    #echo 10.11.1.$ip; 
done

